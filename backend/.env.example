# ==============================================================================
# Nsec VPN - Backend API Environment Configuration
# ==============================================================================

# Server Network Configuration
NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://admin.nsecvpn.com

# PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL=postgresql://nsecvpn_admin:ReplaceWithStrongDatabasePassword2026!@postgres:5432/nsecvpn_db?schema=public

# Cryptographic JSON Web Token Secret (Generate using: openssl rand -hex 32)
JWT_SECRET=ReplaceWithStrongCryptographicJwtSecretKey2026_Minimum32Chars

# Initial Super Administrator Credentials (Used for bootstrap seeding)
ADMIN_EMAIL=admin@nsecvpn.com
ADMIN_PASSWORD=ReplaceWithStrongAdminPassword2026!

# Google Play Developer In-App Billing Service Account (Full JSON String)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Target Android Package Name
PLAY_PACKAGE_NAME=com.nsec.vpn

# Server Policy Toggles
HIDE_PREMIUM_FROM_FREE=false
LOG_LEVEL=info
