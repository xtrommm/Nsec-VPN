# ==============================================================================
# Nsec VPN - Backend API Environment Configuration
# ==============================================================================

# Server Network Configuration
NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://admin.nsecvpn.com

# PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL=

# Cryptographic JSON Web Token Secret (Generate using: openssl rand -hex 32)
JWT_SECRET=

# Initial Super Administrator Credentials (Used for bootstrap seeding)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google Play Developer In-App Billing Service Account (Full JSON String)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Target Android Package Name
PLAY_PACKAGE_NAME=com.nsec.vpn

# Server Policy Toggles
HIDE_PREMIUM_FROM_FREE=false
LOG_LEVEL=info

# Real AdMob rewarded unit registered for server-side verification
ADMOB_REWARDED_UNIT_ID=
REWARDED_PASS_MINUTES=30

# Configure actual per-node credentials here privately. Admin stores env:VARIABLE,
# never the credential itself. Add a distinct variable for each node.
# Enabled admin TOTP uses the same reference mechanism for each authenticator seed.

# Dedicated AES-256-GCM key for retrievable promo codes. Generate once using
# openssl rand -hex 32 and configure privately; keep the same key across deployments.
# Never paste the key into chat, commit it, or replace it without re-encrypting existing codes.
PROMO_CODE_ENCRYPTION_KEY=
