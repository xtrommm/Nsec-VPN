# ==============================================================================
# Nsec VPN - WireGuard Node Agent Daemon Environment Configuration
# ==============================================================================

# Agent Listener Port
AGENT_PORT=51821

# Shared HMAC secret: same private value in backend environment; DB stores its env reference only.
AGENT_SECRET=

# WireGuard Linux Kernel Interface
WG_INTERFACE=wg0

# Disabled by default. Enable only for a protected, temporary legacy backend migration.
ALLOW_LEGACY_AGENT_V1=false
